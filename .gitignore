# Entorno y credenciales privadas
.env
.env.local

# Archivos compilados y cachés
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Archivos generados dinámicamente y subidas locales
comprobantes_fotos/*
!comprobantes_fotos/.gitkeep
generados/*
!generados/.gitkeep

# Base de datos local (en producción se usa Supabase o volumen)
rendiciones.db
rendiciones.db-journal

# Logs
*.log
